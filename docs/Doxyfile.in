# PackageBuilder's documentation: README.md, the whole reference for its CMake functions, as the
# main page. The root CMakeLists.txt states the input, and project-config states the output folder
# and the house look. Only the tags that differ from Doxygen's defaults are listed, and only tags
# every Doxygen from 1.10 on reads, since an unknown tag warns on every run.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"

USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/@PROJECT_CONFIG_DOCS_INPUT@
